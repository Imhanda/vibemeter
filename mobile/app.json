{
  "expo": {
    "name": "VibeMeter",
    "slug": "vibemeter",
    "scheme": "vibemeter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibemeter.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VibeMeter records about 10 seconds of ambient sound when you tap Check In, sends it over HTTPS to our server to measure crowd noise and music energy, and discards it right after — the recording is never saved on your device or ours.",
        "NSLocationWhenInUseUsageDescription": "VibeMeter uses your location to list venues near you and to confirm you're at a venue when you submit a vibe check-in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f14"
      },
      "package": "com.vibemeter.app",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-asset",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.368682546170-26n1ubcieuamj7508msrh7082qkdigre"
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VibeMeter uses your location to list venues near you and to confirm you're at a venue when you submit a vibe check-in.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
